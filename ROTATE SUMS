# ============================================================
# 1. Check if one String is a Rotation of Another
# ============================================================

S = "ABCD"
A = "BCDA"

if len(S) != len(A):
    print(False)
elif S == A:
    print(True)
else:
    found = False

    for rotate in range(1, len(S)):
        M = [""] * len(S)

        for i in range(len(S)):
            M[(i - rotate) % len(S)] = S[i]

        if "".join(M) == A:
            found = True
            break

    print(found)


# ============================================================
# 2. Check if one Array is a Rotation of Another
# ============================================================

A = [1, 2, 3, 4, 5]
B = [3, 4, 5, 1, 2]

if len(A) != len(B):
    print(False)
elif A == B:
    print(True)
else:
    found = False

    for rotate in range(1, len(A)):
        M = [0] * len(A)

        for i in range(len(A)):
            M[(i - rotate) % len(A)] = A[i]

        if M == B:
            found = True
            break

    print(found)


# ============================================================
# 3. Left Rotate an Array by K Positions
# ============================================================

A = [1, 2, 3, 4, 5]
K = 2

Z = [0] * len(A)

for i in range(len(A)):
    Z[(i - K) % len(A)] = A[i]

print(Z)


# ============================================================
# 4. Right Rotate an Array by K Positions
# ============================================================

A = [1, 2, 3, 4, 5]
K = 2

M = [0] * len(A)

for i in range(len(A)):
    M[(i + K) % len(A)] = A[i]

print(M)


# ============================================================
# 5. Find Number of Rotations in a Sorted Rotated Array
# Brute Force Method - Rotate Until Sorted
# ============================================================

A = [4, 5, 6, 7, 1, 2, 3]

Sorted_Array = sorted(A)

count = 0

if A == Sorted_Array:
    print(count)
else:

    for rotate in range(1, len(A)):

        Temp = [0] * len(A)

        for i in range(len(A)):
            Temp[(i - rotate) % len(A)] = A[i]

        count += 1

        if Temp == Sorted_Array:
            print(count)
            break


